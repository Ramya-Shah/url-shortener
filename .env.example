POSTGRES_USER=shortener
POSTGRES_PASSWORD=shortener123
POSTGRES_DB=shortener_db
DATABASE_URL=postgresql+asyncpg://shortener:shortener123@postgres:5432/shortener_db

REDIS_URL=redis://redis:6379/0

# Secret key used for signing JWT login tokens (change this to a long random string!)
JWT_SECRET_KEY=change-this-to-a-random-secret-in-production

# DuckDNS Configuration
DUCKDNS_TOKEN=paste_your_duckdns_token_here
DOMAIN_NAME=your-subdomain.duckdns.org

# Gmail SMTP configuration (use an App Password, NOT your regular Gmail password)
# Generate one at: https://myaccount.google.com/apppasswords
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-16-character-gmail-app-password
